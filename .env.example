# Copy this file to `.env` and fill in real values there.
# `.env` is gitignored — never commit real keys (CLAUDE.md rule 7).

OPENROUTER_API_KEY=

# Optional but recommended: raises Semantic Scholar's rate limit above the
# anonymous tier (which 429s quickly, as seen while building search_papers.py).
# Free key from https://www.semanticscholar.org/product/api -- may arrive by
# email rather than instantly. search_papers.py works without it, just with
# tighter rate limits.
SEMANTIC_SCHOLAR_API_KEY=

# Required: candidates train/evaluate on real Kaggle GPU compute by default
# (harness/tools/kaggle_exec.py, config.EXECUTION_BACKEND = "kaggle"). Get
# both values from https://www.kaggle.com/settings -> API -> Create New Token
# (downloads a kaggle.json containing them). Not needed if you switch
# EXECUTION_BACKEND to "local" in harness/config.py.
KAGGLE_USERNAME=
KAGGLE_KEY=
